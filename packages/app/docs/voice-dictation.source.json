  "cards": [
    {
      "dot": "emerald",
      "title": "Built and tested",
      "items": [
        "35 unit tests over state, chunking, capture and view state",
        "Capture \u2192 transcribe \u2192 insert is wired end to end",
        "No engine registered, so the mic reports unavailable and stays disabled"
      ]
    },
    {
      "dot": "cyan",
      "title": "Interruption rules",
      "items": [
        "A tap under 300 ms is discarded, never transcribed",
        "A new utterance never cancels accepted older work",
        "Late results are fenced off before reaching the composer"
      ]
    },
    {
      "dot": "amber",
      "title": "Latency and memory",
      "items": [
        "Chunked at the 35 s processor window, not the encoder limit",
        "Scratch released after every run, including failures",
        "Weights stay resident; only per-input buffers rotate"
      ]
    },
    {
      "dot": "rose",
      "title": "Boundaries",
      "items": [
        "Audio never leaves the device; no provider key required",
        "Inference in main, because a native module can't ship in the renderer",
        "insertText() is the one new public extension surface"
      ]
    }
  ]
